# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Virtual Environment
venv/
.venv/
env/
ENV/

# Data files (keep large raw & parquet datasets ignored)
/data/raw/
/data/processed/*.parquet
/data/processed/*.csv
*.csv
*.parquet
*.zip
*.tar.gz
*.pkl

# Allow processed demo JSON & metadata required by API and frontend
!/data/processed/*.json
!/frontend/public/data/**

# Allow lightweight deployed model artifacts (<10MB) for Render
!/models/*.joblib
!/models/*.json
!/models/.gitkeep

# Environment variables & secrets
.env
.env.local
*.pem
kaggle.json

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test & coverage
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
.next/
out/
build/
dist/
