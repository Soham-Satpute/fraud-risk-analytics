# Environment Variables Template — Fraud Risk Analytics & Detection System
# Copy this file to .env and configure your environment-specific credentials.

# -----------------------------------------------------------------------------
# Runtime & Server Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=development        # development, production, test
DEBUG=false
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Serving Layer
# -----------------------------------------------------------------------------
# Supabase PostgreSQL Connection String (Session / Transaction Pooling)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
SUPABASE_DB_URL=
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=10
DB_CONNECT_TIMEOUT_SEC=5

# -----------------------------------------------------------------------------
# Public API Security Controls
# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000,https://*.vercel.app

# Maximum allowed request body size in bytes (default 1MB)
MAX_REQUEST_BODY_BYTES=1048576

# Optional API Key (Leave empty to permit open demo access)
API_KEY=

# -----------------------------------------------------------------------------
# Operational Decision Thresholds
# -----------------------------------------------------------------------------
THRESHOLD_MEDIUM=0.10          # Triggers STEP_UP_AUTH
THRESHOLD_HIGH=0.35            # Triggers MANUAL_REVIEW
